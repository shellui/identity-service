# JWT signing (RS256 + JWKS)
# Required in production (DEBUG=false). Generate with: uv run python manage.py generate_jwt_keys
# PEM with literal \n for newlines, e.g. JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=
# Optional: keep previous public key in JWKS during rotation
JWT_PREVIOUS_PUBLIC_KEY=
JWT_PREVIOUS_KEY_ID=
# Default false in production after RS256 migration. Set true only while old HS256 tokens may still be valid.
JWT_ACCEPT_HS256_LEGACY=false
# Required in production (DEBUG=false). Issued tokens include these claims; verifiers should validate them.
JWT_ISSUER=https://auth.example.com
JWT_AUDIENCE=shellui
# Session JWT lifetimes (bare integer = seconds; suffix: s, m, h, d)
JWT_ACCESS_TOKEN_LIFETIME=5m
JWT_REFRESH_TOKEN_LIFETIME=7d
# OAuth login token delivery: code (default, one-time exchange) or fragment (legacy)
OAUTH_TOKEN_DELIVERY=code
OAUTH_SESSION_CODE_TTL_SECONDS=120
# Comma-separated provider ids that skip identity account confirmation after OAuth (default: google when unset).
# OAUTH_SKIP_CONFIRM_PROVIDERS=google
# Set OAUTH_SKIP_CONFIRM_PROVIDERS= (empty) to require confirmation for every provider.

# App runtime
# Required. Used to sign Django sessions and CSRF tokens. Generate with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-generate-a-strong-secret-key
IDENTITY_SERVICE_PORT=8000
DEBUG=true
# One-time web bootstrap token for creating the first superuser when DEBUG=false.
# Leave empty and use `uv run python manage.py createsuperuser` in production.
# When set, open `/?setup_token=<token>` once to use the web form.
SETUP_TOKEN=
# Allow loopback OAuth redirect_to (127.0.0.1 / localhost). Defaults to DEBUG.
OAUTH_ALLOW_LOOPBACK_REDIRECTS=
# Comma-separated hostnames, no scheme (e.g. localhost,127.0.0.1,app.example.com)
ALLOWED_HOSTS=
# Reverse proxies that may set X-Forwarded-For (IPs or CIDRs). Empty = trust REMOTE_ADDR only.
TRUSTED_PROXY_IPS=
# Self-service DELETE /api/v1/user: session access JWT must be issued within this window (not PATs).
SELF_SERVICE_ACCOUNT_DELETE_MAX_IAT_AGE=5m
# Comma-separated full URLs with scheme (e.g. https://app.example.com)
CSRF_TRUSTED_ORIGINS=
POSTGRES_DATABASE_URL=
# Require TLS for Postgres when DEBUG=false (default). Set false only for local Postgres.
POSTGRES_SSL_REQUIRE=
POSTGRES_CONNECT_TIMEOUT=10
# Postgres server-side deadlines in seconds (0 turns one off). Not applied to `migrate`.
POSTGRES_STATEMENT_TIMEOUT=15
POSTGRES_LOCK_TIMEOUT=5
# Redis: shared cache (rate limits, logout denylist, OAuth PKCE state, SAML replay protection)
# across Gunicorn workers, and the broker for the scheduled jobs.
# Required in production (DEBUG=false), also with SCHEDULER_ENABLED=false: without it the
# container logs "REDIS_URL is required when DEBUG is false" and exits with status 1.
# Optional with DEBUG=true only: unset = in-process LocMem and no scheduled jobs.
# REDIS_URL=redis://127.0.0.1:6379/0
# Scheduled jobs (retry_webhooks every minute, purge_expired_data hourly). See docs/scheduled-jobs.md.
# The Docker image runs them in a Celery worker next to gunicorn when REDIS_URL is set.
# Set false when a dedicated worker container (command: worker) or your own cron runs them.
SCHEDULER_ENABLED=true
# Optional: a different Redis for the jobs. Defaults to REDIS_URL (which is still required).
# CELERY_BROKER_URL=
CELERY_WORKER_CONCURRENCY=2
# HTTPS / cookie hardening (defaults follow DEBUG=false in production)
SECURE_SSL_REDIRECT=
SECURE_HSTS_SECONDS=
SESSION_COOKIE_SECURE=
CSRF_COOKIE_SECURE=
# Auth rate limits (requests per window; disable with AUTH_RATE_LIMIT_ENABLED=false)
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_OAUTH=30
AUTH_RATE_LIMIT_TOKEN_REFRESH=60
AUTH_RATE_LIMIT_SETTINGS=30
AUTH_RATE_LIMIT_ADMIN_LOGIN=10
AUTH_RATE_LIMIT_PAT=30
AUTH_RATE_LIMIT_MAGIC_LINK=10
# Passwordless email magic link (company-scoped; see docs/magic-link.md)
MAGIC_LINK_ENABLED=true
MAGIC_LINK_TTL_SECONDS=1800
# Personal access token JWT lifetime (default 30d; was 90d before v0.5.0)
PERSONAL_ACCESS_TOKEN_LIFETIME=30d
# Enterprise SCIM user/group provisioning (on by default; per-company token required). See docs/scim.md.
SCIM_ENABLED=true
# API CORS: multi-tenant shells call /api/v1/* from unknown browser origins (Bearer JWT, no cookies).
# Default allow-all is intentional; OAuth redirect allowlist (CompanyOAuthRedirect) is the token-delivery boundary.
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOW_CREDENTIALS=false
# Optional lock-down (first-party-only): set CORS_ALLOW_ALL_ORIGINS=false and list origins:
CORS_ALLOWED_ORIGINS=http://localhost:4000,http://localhost:5174,https://admin.shellui.com
CORS_ALLOWED_ORIGIN_REGEXES=

# Sentry error reporting (optional; leave empty to disable locally)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

# Logging (always to stdout, also when DEBUG=false). Default INFO, or DEBUG when DEBUG=true.
# LOG_LEVEL=INFO
# Requests slower than this many seconds are logged as a warning. 0 turns it off.
SLOW_REQUEST_THRESHOLD_SECONDS=2

# Gunicorn tuning (Docker entrypoint)
GUNICORN_WORKERS=4
GUNICORN_THREADS=4
# Only catches a frozen worker process. It does not stop a request stuck in a gthread worker.
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEP_ALIVE=75
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=200

# Shellui email-service. See docs/email-service.md.
# Local ports: identity 8000, storage 8001, hosting 8002, email-service 8003.
# Production default when EMAIL_SERVICE_URL is unset: https://email.shellui.com
# Docker Compose sets http://host.docker.internal:8003 so the container can reach the host.
# Unset EMAIL_SERVICE_API_KEY to keep SMTP (or the console backend when DEBUG=true).
EMAIL_SERVICE_URL=http://localhost:8003
# On email-service, EMAIL_AUTH_LINK_HOSTS must include the host of JWT_ISSUER.
# Local identity at http://localhost:8000 uses host localhost, which email-service
# keeps only when its DEBUG=true. When email-service DEBUG=false, localhost,
# 127.0.0.1, and ::1 are removed, so use the public identity host instead.
# EMAIL_SERVICE_API_KEY=
# EMAIL_SERVICE_TIMEOUT_SECONDS=5
# EMAIL_SERVICE_SEND_ATTEMPTS=3
# EMAIL_SERVICE_RETRY_MAX_SLEEP_SECONDS=1

# Action triggers (domain events → webhooks). See docs/actions.md.
# EMAIL_BACKEND=config.email_backends.ConsoleEmailBackend
# Seconds before an SMTP connect, read or write gives up (default 10).
EMAIL_TIMEOUT=10
# ACTIONS_WEBHOOK_TIMEOUT_SECONDS=5
# ACTIONS_OUTBOX_MAX_ATTEMPTS=8
# ACTIONS_WEBHOOK_ALLOW_PRIVATE=false
# ACTIONS_WEBHOOK_RETRY_LEASE_SECONDS=120
# ACTIONS_WEBHOOK_DISPATCH_WORKERS=4
# MAGIC_LINK_EMAIL_DEFAULT_LANGUAGE=en

# identity-service settings. Full reference: docs/configuration.md
# Copy to .env for local runs. Only the settings below are needed; every
# commented-out line shows the default the code uses when it is unset.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Signs sessions and CSRF tokens. At least 50 characters when DEBUG=false. Generate:
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
# Local development only. Unset means false (production).
DEBUG=true
# Public host names, comma-separated, no scheme. Default: localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# Required when DEBUG=false (production):
# Public identity URL (iss claim) and audience (aud claim).
JWT_ISSUER=
JWT_AUDIENCE=
# RS256 signing key, PEM with literal \n. Generate: uv run python manage.py generate_jwt_keys
JWT_PRIVATE_KEY=
# Shared cache and job broker. The container exits without it when DEBUG=false.
REDIS_URL=
# Full HTTPS origin behind TLS, for example https://auth.example.com
CSRF_TRUSTED_ORIGINS=

# ---------------------------------------------------------------------------
# Optional (defaults shown)
# ---------------------------------------------------------------------------

# Database: SQLite unless POSTGRES_DATABASE_URL is set
# POSTGRES_DATABASE_URL=
# SQLITE_PATH=db.sqlite3
# POSTGRES_SSL_REQUIRE=true
# POSTGRES_CONNECT_TIMEOUT=10
# POSTGRES_STATEMENT_TIMEOUT=15
# POSTGRES_LOCK_TIMEOUT=5

# Tokens
# JWT_PUBLIC_KEY=
# JWT_KEY_ID=
# JWT_PREVIOUS_PUBLIC_KEY=
# JWT_PREVIOUS_KEY_ID=
# JWT_ACCEPT_HS256_LEGACY=false
# JWT_ACCESS_TOKEN_LIFETIME=5m
# JWT_REFRESH_TOKEN_LIFETIME=7d
# PERSONAL_ACCESS_TOKEN_LIFETIME=30d
# SELF_SERVICE_ACCOUNT_DELETE_MAX_IAT_AGE=5m

# Sign-in
# OAUTH_TOKEN_DELIVERY=code
# OAUTH_SESSION_CODE_TTL_SECONDS=120
# OAUTH_SKIP_CONFIRM_PROVIDERS=google
# OAUTH_ALLOW_LOOPBACK_REDIRECTS=false
# MAGIC_LINK_ENABLED=true
# MAGIC_LINK_TTL_SECONDS=1800
# MAGIC_LINK_EMAIL_DEFAULT_LANGUAGE=en
# SCIM_ENABLED=true
# SETUP_TOKEN=

# Email: email-service when EMAIL_SERVICE_API_KEY is set, else SMTP (console with DEBUG=true)
# EMAIL_SERVICE_API_KEY=
# EMAIL_SERVICE_URL=https://email.shellui.com
# EMAIL_SERVICE_TIMEOUT_SECONDS=5
# EMAIL_SERVICE_SEND_ATTEMPTS=3
# EMAIL_SERVICE_RETRY_MAX_SLEEP_SECONDS=1
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=localhost
# EMAIL_PORT=25
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=false
# EMAIL_USE_SSL=false
# EMAIL_TIMEOUT=10
# DEFAULT_FROM_EMAIL=noreply@localhost

# Webhooks
# ACTIONS_WEBHOOK_TIMEOUT_SECONDS=5
# ACTIONS_OUTBOX_MAX_ATTEMPTS=8
# ACTIONS_WEBHOOK_ALLOW_PRIVATE=false
# ACTIONS_WEBHOOK_RETRY_LEASE_SECONDS=120
# ACTIONS_WEBHOOK_DISPATCH_WORKERS=4
# ACTIONS_WEBHOOK_SYNC_DELIVERY=false

# Scheduled jobs
# SCHEDULER_ENABLED=true
# CELERY_BROKER_URL=
# CELERY_WORKER_CONCURRENCY=2
# CELERY_BEAT_SCHEDULE_FILE=/tmp/celerybeat-schedule

# Security
# TRUSTED_PROXY_IPS=
# CORS_ALLOW_ALL_ORIGINS=true
# CORS_ALLOW_CREDENTIALS=false
# CORS_ALLOWED_ORIGINS=
# CORS_ALLOWED_ORIGIN_REGEXES=
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# SECURE_HSTS_PRELOAD=false
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true

# Rate limits (requests per window)
# AUTH_RATE_LIMIT_ENABLED=true
# AUTH_RATE_LIMIT_OAUTH=30
# AUTH_RATE_LIMIT_TOKEN_REFRESH=60
# AUTH_RATE_LIMIT_SETTINGS=30
# AUTH_RATE_LIMIT_ADMIN_LOGIN=10
# AUTH_RATE_LIMIT_PAT=30
# AUTH_RATE_LIMIT_MAGIC_LINK=10
# AUTH_RATE_LIMIT_INVITATION=30

# Observability
# LOG_LEVEL=INFO
# SLOW_REQUEST_THRESHOLD_SECONDS=2
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0
# SHELLUI_GEOIP_DATABASE_PATH=

# Gunicorn (Docker entrypoint) and Docker Compose
# GUNICORN_WORKERS=4
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=60
# GUNICORN_GRACEFUL_TIMEOUT=30
# GUNICORN_KEEP_ALIVE=75
# GUNICORN_MAX_REQUESTS=1000
# GUNICORN_MAX_REQUESTS_JITTER=200
# IDENTITY_SERVICE_PORT=8000

# Instance role (docs/instance-roles.md). Unset = standalone.
# SHELLUI_INSTANCE_ROLE=
# Global role (OpenID Provider)
# OIDC_CLIENTS=
# OIDC_CORS_ALLOWED_ORIGINS=
# OIDC_SESSION_TTL_SECONDS=43200
# OIDC_CODE_TTL_SECONDS=60
# OIDC_ID_TOKEN_TTL_SECONDS=300
# OIDC_BACKCHANNEL_TIMEOUT_SECONDS=3
# Region role (required with SHELLUI_INSTANCE_ROLE=region)
# GLOBAL_ISSUER_URL=
# GLOBAL_JWKS=
# GLOBAL_CLIENT_ID=
# GLOBAL_CLIENT_SECRET=
# GLOBAL_REDIRECT_URI=
# Provisioning API (region role; empty PROVISIONING_PUBLIC_KEY turns it off)
# PROVISIONING_PUBLIC_KEY=
# PROVISIONING_KEY_ID=
# PROVISIONING_ISSUER=
# PROVISIONING_AUDIENCE=
# PROVISIONING_DEFAULT_REDIRECTS=

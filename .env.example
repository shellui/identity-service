# JWT signing (RS256 + JWKS)
# Required in production (DEBUG=false). Generate with: uv run python manage.py generate_jwt_keys
# PEM with literal \n for newlines, e.g. JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=
# Optional: keep previous public key in JWKS during rotation
JWT_PREVIOUS_PUBLIC_KEY=
JWT_PREVIOUS_KEY_ID=
# Default false in production after RS256 migration. Set true only while old HS256 tokens may still be valid.
JWT_ACCEPT_HS256_LEGACY=false
# Required in production (DEBUG=false). Issued tokens include these claims; verifiers should validate them.
JWT_ISSUER=https://auth.example.com
JWT_AUDIENCE=shellui
# Session JWT lifetimes (bare integer = seconds; suffix: s, m, h, d)
JWT_ACCESS_TOKEN_LIFETIME=5m
JWT_REFRESH_TOKEN_LIFETIME=7d
# OAuth login token delivery: code (default, one-time exchange) or fragment (legacy)
OAUTH_TOKEN_DELIVERY=code
OAUTH_SESSION_CODE_TTL_SECONDS=120

# App runtime
# Required. Used to sign Django sessions and CSRF tokens. Generate with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-generate-a-strong-secret-key
IDENTITY_SERVICE_PORT=8000
DEBUG=true
# One-time web bootstrap token for creating the first superuser when DEBUG=false.
# Leave empty and use `uv run python manage.py createsuperuser` in production.
# When set, open `/?setup_token=<token>` once to use the web form.
SETUP_TOKEN=
# Allow loopback OAuth redirect_to (127.0.0.1 / localhost). Defaults to DEBUG.
OAUTH_ALLOW_LOOPBACK_REDIRECTS=
# Comma-separated hostnames, no scheme (e.g. localhost,127.0.0.1,app.example.com)
ALLOWED_HOSTS=
# Reverse proxies that may set X-Forwarded-For (IPs or CIDRs). Empty = trust REMOTE_ADDR only.
TRUSTED_PROXY_IPS=
# Comma-separated full URLs with scheme (e.g. https://app.example.com)
CSRF_TRUSTED_ORIGINS=
POSTGRES_DATABASE_URL=
# Require TLS for Postgres when DEBUG=false (default). Set false only for local Postgres.
POSTGRES_SSL_REQUIRE=
# Shared cache (optional). Set in multi-worker production so rate limits and logout denylist
# are shared across Gunicorn workers. Unset = in-process LocMem (fine for local dev).
# REDIS_URL=redis://127.0.0.1:6379/0
# HTTPS / cookie hardening (defaults follow DEBUG=false in production)
SECURE_SSL_REDIRECT=
SECURE_HSTS_SECONDS=
SESSION_COOKIE_SECURE=
CSRF_COOKIE_SECURE=
# Auth rate limits (requests per window; disable with AUTH_RATE_LIMIT_ENABLED=false)
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_OAUTH=30
AUTH_RATE_LIMIT_TOKEN_REFRESH=60
AUTH_RATE_LIMIT_SETTINGS=30
AUTH_RATE_LIMIT_ADMIN_LOGIN=10
AUTH_RATE_LIMIT_PAT=30
# Personal access token JWT lifetime (default 30d; was 90d before v0.5.0)
PERSONAL_ACCESS_TOKEN_LIFETIME=30d
# API CORS: multi-tenant shells call /api/v1/* from unknown browser origins (Bearer JWT, no cookies).
# Default allow-all is intentional; OAuth redirect allowlist (CompanyOAuthRedirect) is the token-delivery boundary.
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOW_CREDENTIALS=false
# Optional lock-down (first-party-only): set CORS_ALLOW_ALL_ORIGINS=false and list origins:
CORS_ALLOWED_ORIGINS=http://localhost:4000,http://localhost:5174,https://admin.shellui.com
CORS_ALLOWED_ORIGIN_REGEXES=

# Sentry error reporting (optional; leave empty to disable locally)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

# Gunicorn tuning
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

  {
    "name": "identity_create_action_rules",
    "description": "Creates a webhook rule for event_type that posts to url, and returns the rule. The signing secret is shown once on the admin HTTP response and is masked in this result.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "event_type": {
          "description": "Webhook event type id.",
          "type": "string",
          "enum": [
            "identity.auth.magic_link.requested",
            "identity.group.created",
            "identity.group.deleted",
            "identity.group.membership_changed",
            "identity.group.updated",
            "identity.scim.provisioning_conflict",
            "identity.scim.token.created",
            "identity.scim.token.revoked",
            "identity.scim.user.deprovisioned",
            "identity.scim.user.provisioned",
            "identity.user.created",
            "identity.user.deleted",
            "identity.user.invitation_revoked",
            "identity.user.invited",
            "identity.user.updated"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "url": {
          "description": "HTTPS webhook URL. Required when creating a rule.",
          "type": "string",
          "format": "uri"
        },
        "secret": {
          "type": "string"
        },
        "authorization_header": {
          "type": "string"
        },
        "allow_private_urls": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "event_type",
        "name",
        "url"
      ]
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true
    }
  },
